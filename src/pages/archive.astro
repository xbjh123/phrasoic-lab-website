---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { POSTS, SITE } from '../data/posts';
const SITE_NAME = 'PHRASOIC LAB';
---

<BaseLayout title={`Archive — ${SITE.name}`}>
  <Nav />
  <main class="ar">
    <div class="ar__in content-wrap">
      <header class="ar__hd">
        <div class="ar__meta"><span>&#9670;</span> <span class="lang-en">ARCHIVE</span><span class="lang-zh">归档</span></div>
        <h1 class="ar__t">Entries</h1>
        <p class="ar__d"><span class="lang-en">All transmissions, in chronological order.</span><span class="lang-zh">全部传输，按时间排序。</span></p>
      </header>
      <div class="ar__list">
        {POSTS.map((p) => (
          <a href={`/phrasoic-lab-website/blog/${p.slug || p.docId}`} class="ar__item">
            <div class="ar__item-bar"><span class="ar__dot"></span><span class="ar__cat">{p.cat}</span><span class="ar__doc">{p.docId}</span></div>
            <div class="ar__item-body">
              <h2 class="ar__item-title">{p.title}</h2>
              <p class="ar__item-excerpt">{p.excerpt}</p>
              <div class="ar__item-meta">
                <div class="ar__item-tags">{p.tags.map((t) => (<span class="ar__tag"># {t}</span>))}</div>
                <span class="ar__item-date"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> {p.date} · {p.min} min</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style lang="scss" is:global>
  @use '../styles/tokens' as *;
  @use '../styles/glass';

  .ar { padding-top:calc(#{$nav-height} + #{$space-10}); padding-bottom:$space-24; min-height:100vh; }
  .ar__in { max-width:800px; }
  .ar__hd { margin-bottom:$space-12; }
  .ar__meta { display:flex; align-items:center; gap:6px; font-size:.68rem; color:var(--primary); font-family:$font-mono; letter-spacing:.06em; }
  .ar__t { font-family:$font-display; font-size:clamp(2rem,5vw,3.5rem); font-weight:$weight-black; line-height:1.1; letter-spacing:-.02em; color:var(--text); margin-top:$space-2;
    [data-theme="dark"] & { color:$dark-text; }
  }
  .ar__d { font-size:.95rem; color:var(--text-light); margin-top:$space-2; }

  .ar__list { display:flex; flex-direction:column; gap:$space-4; }
  .ar__item { display:block; text-decoration:none; @include glass.glass-l2; overflow:hidden; transition:transform .2s,box-shadow .4s;
    &:hover { transform:translateY(-1px); box-shadow:0 6px 40px rgba(0,0,0,.06),0 0 80px rgba(140,145,150,.07);
      [data-theme="dark"] & { box-shadow:0 6px 40px rgba(0,0,0,.35),0 0 80px rgba(100,105,110,.04); }
    }
  }
  .ar__item-bar { display:flex; align-items:center; gap:8px; padding:6px 16px; background:rgba($color-primary,.06); border-bottom:1px solid var(--border-light);
    [data-theme="dark"] & { background:rgba($dark-bg,.5); border-color:$dark-border; }
  }
  .ar__dot { width:5px;height:5px;border-radius:50%;background:$color-primary;
    [data-theme="dark"] & { background:$dark-primary; }
  }
  .ar__cat { font-family:$font-mono; font-size:.6rem; color:var(--primary); letter-spacing:.05em; }
  .ar__doc { margin-left:auto; font-family:$font-mono; font-size:.58rem; color:var(--text-muted); opacity:.4; }
  .ar__item-body { padding:18px; display:flex; flex-direction:column; gap:8px; }
  .ar__item-title { font-family:$font-display; font-size:1.15rem; font-weight:$weight-bold; line-height:1.3; color:var(--text);
    [data-theme="dark"] & { color:$dark-text; }
    .ar__item:hover & { color:var(--accent); }
  }
  .ar__item-excerpt { font-size:.85rem; line-height:1.5; color:var(--text-light);
    [data-theme="dark"] & { color:$dark-text-light; }
  }
  .ar__item-meta { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-top:4px; }
  .ar__item-tags { display:flex; gap:10px; flex-wrap:wrap; }
  .ar__tag { font-size:.65rem; color:var(--primary); font-family:$font-mono; opacity:.6; }
  .ar__item-date { display:flex; align-items:center; gap:4px; font-size:.62rem; color:var(--text-muted); font-family:$font-mono; white-space:nowrap; }
</style>
