---
// ============================================================
// PHRASOIC LAB · Nav
// ============================================================
const links = [
  { href: "/",        en: "HOME",    zh: "首页" },
  { href: "/search",  en: "SEARCH",  zh: "搜索" },
  { href: "/archive", en: "ARCHIVE", zh: "归档" },
  { href: "/about",   en: "ABOUT",   zh: "关于" },
];
---

<header class="nav" id="nav">
  <div class="nav__inner content-wrap">
    <!-- Brand -->
    <div class="nav__brand">
      <span class="nav__brand-label">PHRASOIC</span>
      <div class="nav__brand-dot" aria-hidden="true"></div>
      <span class="nav__brand-sub">LAB.BLOG</span>
    </div>

    <!-- Desktop links -->
    <nav class="nav__links" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class="nav__link">
          <span class="lang-en">{l.en}</span>
          <span class="lang-zh">{l.zh}</span>
        </a>
      ))}
    </nav>

    <!-- Spacer -->
    <div class="nav__spacer"></div>

    <!-- Lang toggle -->
    <button
      class="nav__lang-btn"
      id="lang-toggle"
      aria-label="Toggle language"
    >EN</button>

    <!-- Theme toggle -->
    <button
      class="nav__theme-btn"
      id="theme-toggle"
      aria-label="Toggle theme"
      title="Toggle light/dark mode"
    >
      <svg class="nav__theme-icon nav__theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="nav__theme-icon nav__theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

<!-- Theme + Lang toggle -->
<script>
  const btn = document.getElementById('theme-toggle');
  const langBtn = document.getElementById('lang-toggle');
  const html = document.documentElement;

  function setTheme(t) {
    html.classList.add('theme-switching');
    html.setAttribute('data-theme', t);
    localStorage.setItem('theme', t);
    setTimeout(() => html.classList.remove('theme-switching'), 800);
  }

  btn?.addEventListener('click', () => {
    const current = html.getAttribute('data-theme');
    setTheme(current === 'dark' ? 'light' : 'dark');
  });

  // Simple lang toggle
  const savedLang = localStorage.getItem('lang') || 'en';
  html.setAttribute('data-lang', savedLang);
  if (langBtn) langBtn.textContent = savedLang === 'zh' ? '中' : 'EN';

  langBtn?.addEventListener('click', () => {
    const next = html.getAttribute('data-lang') === 'zh' ? 'en' : 'zh';
    html.setAttribute('data-lang', next);
    localStorage.setItem('lang', next);
    langBtn.textContent = next === 'zh' ? '中' : 'EN';
  });
</script>

<style lang="scss" is:global>
  @use '../styles/tokens' as *;
  @use '../styles/glass';

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: $nav-height;
    @include glass.glass-l3;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: $space-8;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: $space-2;
    flex-shrink: 0;
  }

  .nav__brand-label {
    font-family: $font-display;
    font-weight: $weight-bold;
    font-size: 0.85rem;
    color: var(--text);
    letter-spacing: -0.01em;

    [data-theme="dark"] & {
      color: $dark-text;
    }
  }

  .nav__brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: $color-accent;
    flex-shrink: 0;

    [data-theme="dark"] & {
      background: $dark-accent;
    }
  }

  .nav__brand-sub {
    font-family: $font-display;
    font-size: 0.7rem;
    font-weight: $weight-regular;
    color: var(--text-muted);
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: $space-6;

    @media (min-width: $bp-tablet) {
      display: flex;
    }
  }

  .nav__link {
    font-family: $font-display;
    font-size: 0.75rem;
    font-weight: $weight-medium;
    letter-spacing: 0.02em;
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.15s ease;

    &:hover {
      color: var(--accent);
    }
  }

  .nav__spacer {
    flex: 1;
  }

  .nav__lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-light);
    border-radius: $border-radius;
    background: transparent;
    cursor: pointer;
    font-family: $font-display;
    font-size: 0.7rem;
    font-weight: $weight-semibold;
    color: var(--text-light);
    transition: border-color 0.15s ease, color 0.15s ease;
    margin-right: $space-2;

    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .nav__theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-light);
    border-radius: $border-radius;
    background: transparent;
    cursor: pointer;
    color: var(--text-light);
    transition: border-color 0.15s ease, color 0.15s ease;

    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .nav__theme-icon--sun {
    display: block;
  }
  .nav__theme-icon--moon {
    display: none;
  }

  [data-theme="dark"] .nav__theme-icon--sun {
    display: none;
  }
  [data-theme="dark"] .nav__theme-icon--moon {
    display: block;
  }
</style>
